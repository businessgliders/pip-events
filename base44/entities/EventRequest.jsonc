{
  "name": "EventRequest",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "Birthday",
        "Bridal Shower",
        "Bachelorette Party",
        "Corporate Wellness Event",
        "Private Class",
        "Other"
      ]
    },
    "event_date": {
      "type": "string",
      "format": "date"
    },
    "additional_dates": {
      "type": "string"
    },
    "preferred_times": {
      "type": "string"
    },
    "number_of_guests": {
      "type": "number"
    },
    "time_slot": {
      "type": "string",
      "enum": [
        "Peak Hours (Fri-Sun, 10AM-6PM)",
        "Non-Peak Hours (Mon-Thu, 12:30-3:30PM)"
      ]
    },
    "duration": {
      "type": "string",
      "enum": [
        "2 Hours",
        "3 Hours",
        "4 Hours"
      ]
    },
    "selected_classes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "add_ons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    },
    "budget": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "New",
        "In Conversations",
        "Pending",
        "Confirmed",
        "Completed",
        "Cancelled"
      ],
      "default": "New"
    },
    "admin_notes": {
      "type": "string"
    },
    "submitted_date": {
      "type": "string",
      "format": "date-time",
      "description": "Original submission date from the client's form or CSV"
    },
    "ticket_number": {
      "type": "number",
      "description": "Sequential ticket number used in email subject for threading"
    },
    "gmail_thread_id": {
      "type": "string",
      "description": "Gmail thread ID for the email conversation with this client"
    },
    "gmail_root_message_id": {
      "type": "string",
      "description": "RFC Message-ID header of the very first email sent (used for threading replies)"
    },
    "ai_suggestions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "body_html": {
            "type": "string"
          }
        }
      },
      "description": "Cached AI reply suggestions"
    },
    "ai_suggestions_generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "ai_suggestions_message_count": {
      "type": "number",
      "description": "Count of EmailMessage rows when suggestions were generated (used for cache invalidation)"
    },
    "email_log": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sent_at": {
            "type": "string"
          },
          "template_name": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "body_html": {
            "type": "string"
          },
          "direction": {
            "type": "string",
            "description": "outbound or initial"
          },
          "gmail_message_id": {
            "type": "string"
          },
          "rfc_message_id": {
            "type": "string",
            "description": "RFC Message-ID header value (for threading)"
          }
        }
      }
    },
    "archived": {
      "type": "boolean",
      "default": false,
      "description": "Whether the request has been archived off the Kanban board"
    },
    "status_history": {
      "type": "array",
      "description": "Audit log of status changes",
      "items": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "required": [
    "full_name",
    "email",
    "event_type",
    "event_date"
  ],
  "rls": {
    "create": {},
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}